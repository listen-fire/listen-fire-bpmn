{
  "name": "listen-fire-bpmn",
  "version": "0.1.0",
  "private": true,
  "description": "Render a listen-fire program as a BPMN 2.0 diagram",
  "type": "module",
  "bin": {
    "listen-fire-bpmn": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "dependencies": {
    "@listen-fire/movement-lang": "0.12.13",
    "bpmn-moddle": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.5.4",
    "vitest": "3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "code:type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "examples": "vitest run -u"
  },
  "files": [
    "dist"
  ]
}
