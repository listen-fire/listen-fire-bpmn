<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:lf="https://listen-fire.dev/schema/bpmn" id="Definitions_1" targetNamespace="https://listen-fire.dev/schema/bpmn" exporter="@listen-fire/bpmn" exporterVersion="0.16.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Payment Failed" processRef="Process_Payment_Failed" lf:kind="pool" />
    <bpmn:participant id="Participant_2" name="Stripe" lf:kind="system">
      <bpmn:documentation>Connected system: `stripe`, a connection of stripe. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_3" name="Attio" lf:kind="system">
      <bpmn:documentation>Connected system: `crm`, a connection of attio. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_4" name="Gmail" lf:kind="system">
      <bpmn:documentation>Connected system: `mail`, a connection of gmail. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_5" name="Slack" lf:kind="system">
      <bpmn:documentation>Connected system: `chat`, a connection of slack. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MessageFlow_1" name="reads Invoices › Changes" sourceRef="Participant_2" targetRef="StartEvent_1" />
    <bpmn:messageFlow id="MessageFlow_2" name="reads Invoice" sourceRef="Participant_2" targetRef="ServiceTask_1" />
    <bpmn:messageFlow id="MessageFlow_3" name="reads People" sourceRef="Participant_3" targetRef="ServiceTask_2" />
    <bpmn:messageFlow id="MessageFlow_4" name="writes Messages" sourceRef="ServiceTask_3" targetRef="Participant_4" />
    <bpmn:messageFlow id="MessageFlow_5" name="reads Channels" sourceRef="Participant_5" targetRef="ServiceTask_4" />
    <bpmn:messageFlow id="MessageFlow_6" name="writes Messages" sourceRef="ServiceTask_5" targetRef="Participant_5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Payment_Failed" name="Payment Failed" isExecutable="false">
    <bpmn:documentation>Function `Payment Failed` in payment_failed.mvt, drawn by @listen-fire/bpmn from the checked program.
Connected systems it touches: Stripe, Attio, Gmail, Slack.
Queries are carried as text, types are dropped, and expressions are folded into the steps that use them; the program is the authority.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="On Stripe Invoices › Changes&#10;→ c" lf:kind="read">
      <bpmn:documentation>listen to stripe-[:Invoices]->-[c:Changes WHERE c.Kind == "payment_failed"]-> fire `Payment Failed`</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Read Stripe Invoice&#10;→ invoice" lf:kind="read">
      <bpmn:documentation>invoice = only(c-[:Invoice]->)</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" default="Flow_4" lf:kind="decision">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1" />
    <bpmn:endEvent id="EndEvent_1" name="Fail: payment_failed event ‹c.Id› has no invoice" lf:kind="failure">
      <bpmn:documentation>fail("payment_failed event ${c.Id} has no invoice")</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_1" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" name="no invoice" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">invoice == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_2" name="Read Attio People&#10;→ person" lf:kind="read">
      <bpmn:documentation>person = first(crm-[p:People WHERE p.Email == email ORDER BY p.`Created At`]->)
where email = invoice.`Customer Email`</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" default="Flow_7" lf:kind="decision">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2" />
    <bpmn:endEvent id="EndEvent_2" name="Fail: ‹email› not found in the CRM (invoice ‹invoice.Id›)" lf:kind="failure">
      <bpmn:documentation>fail("${email} not found in the CRM (invoice ${invoice.Id})")</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_2" errorRef="Error_2" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" name="no person" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">person == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" default="Flow_13" lf:kind="decision">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3" />
    <bpmn:serviceTask id="ServiceTask_3" name="Write Gmail Messages" lf:kind="write">
      <bpmn:documentation>write mail-[:Messages]-> {
      To: [email]
      Subject: "Your Ledgerline payment didn't go through"
      Body: "Hi ${coalesce(person.Name, invoice.`Customer Name`, "there")},\n\nWe tried to take your Ledgerline payment of ${amount} and it didn't go through. It's usually an expired card or a bank check.\n\nYou can update your card and pay here: ${invoice.`Hosted Invoice URL`}\n\nWe'll try again in a few days. If anything's changed, just reply to this email.\n\nThe Ledgerline team"
    }
where email = invoice.`Customer Email`
where amount = invoice.Currency == "usd" ? "$${figure}" : "${figure} ${Text.upper(invoice.Currency)}"</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_8" name="person.Plan == &#34;monthly&#34;" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">person.Plan == "monthly"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_4" name="Read Slack Channels&#10;→ channel" lf:kind="read">
      <bpmn:documentation>channel = only(chat-[ch:Channels WHERE ch.Name == "accounts"]->)</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_9" name="person.Plan == &#34;yearly&#34;" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">person.Plan == "yearly"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" default="Flow_12" lf:kind="decision">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ServiceTask_4" targetRef="ExclusiveGateway_4" />
    <bpmn:endEvent id="EndEvent_3" name="Fail: #accounts not found" lf:kind="failure">
      <bpmn:documentation>fail("#accounts not found")</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_3" errorRef="Error_3" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" name="no channel" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">channel == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_5" name="Write Slack Messages" lf:kind="write">
      <bpmn:documentation>write channel-[:Messages]-> {
      Message: "Annual customer payment failed: ${coalesce(person.Name, email)} (${email}), ${amount}. Account manager: ${coalesce(person.`Account manager`, "not assigned")}. Invoice: ${invoice.`Hosted Invoice URL`}"
    }
where email = invoice.`Customer Email`
where amount = invoice.Currency == "usd" ? "$${figure}" : "${figure} ${Text.upper(invoice.Currency)}"</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_5" />
    <bpmn:endEvent id="EndEvent_4" name="Fail: ‹email› has no plan in the CRM (invoice ‹invoice.Id›)" lf:kind="failure">
      <bpmn:documentation>fail("${email} has no plan in the CRM (invoice ${invoice.Id})")</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_4" errorRef="Error_4" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13" name="else" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_4" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_5" lf:kind="decision">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_5" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ServiceTask_5" targetRef="ExclusiveGateway_5" />
    <bpmn:endEvent id="EndEvent_5" name="Done" lf:kind="plain">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="ExclusiveGateway_5" targetRef="EndEvent_5" />
  </bpmn:process>
  <bpmn:message id="Message_1" name="Stripe Invoices › Changes" />
  <bpmn:error id="Error_1" name="payment_failed event ‹c.Id› has no invoice" />
  <bpmn:error id="Error_2" name="‹email› not found in the CRM (invoice ‹invoice.Id›)" />
  <bpmn:error id="Error_3" name="#accounts not found" />
  <bpmn:error id="Error_4" name="‹email› has no plan in the CRM (invoice ‹invoice.Id›)" />
