<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="https://listen-fire.dev/schema/bpmn" exporter="listen-fire-bpmn" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="triage" processRef="Process_triage" />
    <bpmn:participant id="Participant_2" name="Email">
      <bpmn:documentation>Connected system: `inbox = connect email …`. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_3" name="Slack">
      <bpmn:documentation>Connected system: `chat = connect slack …`. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_4" name="Gmail">
      <bpmn:documentation>Connected system: `mail = connect gmail …`. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Participant_2" targetRef="StartEvent_1" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Participant_3" targetRef="ServiceTask_2" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="SendTask_1" targetRef="Participant_3" />
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="SendTask_2" targetRef="Participant_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_triage" name="triage" isExecutable="false">
    <bpmn:documentation>Function `triage` in support-email-triage.mvt, drawn by listen-fire-bpmn from the parsed program.
Connected systems it touches: Slack, Gmail, Email.
Queries are carried as text, types are dropped, and expressions are folded into the steps that use them; the program is the authority.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="On new Email">
      <bpmn:documentation>listen to inbox { key: "support" } fire triage</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Extract Verdict (AI)" implementation="urn:listen-fire:ai">
      <bpmn:documentation>AI step. Output: one Verdict or nothing. Settings: { tier: "careful" }.
verdict  = extractOne([m.Subject, m.Body], Verdict, { tier: "careful" })</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" default="Flow_7">
      <bpmn:documentation>where category = coalesce(verdict.category, "normal")</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1" />
    <bpmn:serviceTask id="ServiceTask_2" name="Read Slack Channels">
      <bpmn:documentation>oncall = only(chat-[ch:Channels WHERE ch.Name == "oncall"]-&gt;)</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" name="category == &#34;urgent&#34;" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">category == "urgent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" default="Flow_6">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2" />
    <bpmn:endEvent id="EndEvent_1" name="Fail: no #oncall channel">
      <bpmn:documentation>fail("no #oncall channel") </bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_1" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" name="oncall == null" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">oncall == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="SendTask_1" name="Post to Slack channel">
      <bpmn:documentation>write oncall-[:Messages]-&gt; { Message: "Urgent support email from `${who}`: `${line}`" }
where who = sender != "" ? sender : "unknown sender"
where line = safe ? summary : "(summary withheld: see the email)"</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ExclusiveGateway_2" targetRef="SendTask_1" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_3">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_3" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="SendTask_1" targetRef="ExclusiveGateway_3" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" default="Flow_13">
      <bpmn:documentation>where category = coalesce(verdict.category, "normal")</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_5" default="Flow_12">
      <bpmn:documentation>where sender = Text.regexExtract(m.From, "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+)", 1)</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_10" name="category == &#34;normal&#34;" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">category == "normal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_2" name="Fail: normal email with no sender address to reply to">
      <bpmn:documentation>fail("normal email with no sender address to reply to") </bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_2" errorRef="Error_2" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" name="sender == &#34;&#34;" sourceRef="ExclusiveGateway_5" targetRef="EndEvent_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sender == ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="SendTask_2" name="Send Gmail message">
      <bpmn:documentation>write mail-[:Messages]-&gt; {
      To: [sender]
      Subject: "We have received your message"
      Body: "Thank you for contacting support. We have received your message and will respond within one working day."
    }
where sender = Text.regexExtract(m.From, "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+)", 1)</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ExclusiveGateway_5" targetRef="SendTask_2" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_6">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_6" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="SendTask_2" targetRef="ExclusiveGateway_6" />
    <bpmn:endEvent id="EndEvent_3" name="Done">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ExclusiveGateway_6" targetRef="EndEvent_3" />
  </bpmn:process>
  <bpmn:message id="Message_1" name="Email Email" />
  <bpmn:error id="Error_1" name="no #oncall channel" />
  <bpmn:error id="Error_2" name="normal email with no sender address to reply to" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1604" height="366" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="70" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_1_di" bpmnElement="ServiceTask_1">
        <dc:Bounds x="156" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="106" y="80" />
        <di:waypoint x="156" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ExclusiveGateway_1_di" bpmnElement="ExclusiveGateway_1">
        <dc:Bounds x="306" y="55" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="256" y="80" />
        <di:waypoint x="306" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ServiceTask_2_di" bpmnElement="ServiceTask_2">
        <dc:Bounds x="406" y="165" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="331" y="105" />
        <di:waypoint x="331" y="205" />
        <di:waypoint x="406" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ExclusiveGateway_2_di" bpmnElement="ExclusiveGateway_2">
        <dc:Bounds x="556" y="180" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="506" y="205" />
        <di:waypoint x="556" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="656" y="290" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="581" y="230" />
        <di:waypoint x="581" y="308" />
        <di:waypoint x="656" y="308" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="SendTask_1_di" bpmnElement="SendTask_1">
        <dc:Bounds x="742" y="165" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="606" y="205" />
        <di:waypoint x="742" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ExclusiveGateway_3_di" bpmnElement="ExclusiveGateway_3">
        <dc:Bounds x="892" y="55" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="356" y="80" />
        <di:waypoint x="892" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="842" y="205" />
        <di:waypoint x="917" y="205" />
        <di:waypoint x="917" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ExclusiveGateway_4_di" bpmnElement="ExclusiveGateway_4">
        <dc:Bounds x="992" y="55" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="942" y="80" />
