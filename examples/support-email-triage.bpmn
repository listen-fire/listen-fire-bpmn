      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="SendTask_2_di" bpmnElement="SendTask_2">
        <dc:Bounds x="1278" y="165" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1142" y="205" />
