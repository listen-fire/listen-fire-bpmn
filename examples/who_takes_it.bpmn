<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:lf="https://listen-fire.dev/schema/bpmn" id="Definitions_1" targetNamespace="https://listen-fire.dev/schema/bpmn" exporter="@listen-fire/bpmn" exporterVersion="0.16.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Who Takes It" processRef="Process_Who_Takes_It" lf:kind="pool" />
    <bpmn:participant id="Participant_2" name="Slack" lf:kind="system">
      <bpmn:documentation>Connected system: `team`, a connection of slack. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MessageFlow_1" name="reads Channels" sourceRef="Participant_2" targetRef="ServiceTask_1" />
    <bpmn:messageFlow id="MessageFlow_2" name="writes Messages" sourceRef="ServiceTask_2" targetRef="Participant_2" />
    <bpmn:messageFlow id="MessageFlow_3" name="reads Replies" sourceRef="Participant_2" targetRef="IntermediateCatchEvent_1" />
    <bpmn:messageFlow id="MessageFlow_4" name="writes Messages" sourceRef="ServiceTask_3" targetRef="Participant_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Who_Takes_It" name="Who Takes It" isExecutable="false">
    <bpmn:documentation>Function `Who Takes It` in who_takes_it.mvt, drawn by @listen-fire/bpmn from the checked program.
Connected systems it touches: Slack.
Queries are carried as text, types are dropped, and expressions are folded into the steps that use them; the program is the authority.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="Started manually&#10;→ go" lf:kind="plain">
      <bpmn:documentation>listen to manual-[:Invocations]-> fire `Who Takes It`</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Read Slack Channels&#10;→ dealflow" lf:kind="read">
      <bpmn:documentation>dealflow = only(team-[ch:Channels WHERE ch.Name == "dealflow"]->)</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" default="Flow_4" lf:kind="decision">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1" />
    <bpmn:endEvent id="EndEvent_1" name="Fail: no #dealflow channel" lf:kind="failure">
      <bpmn:documentation>fail("no #dealflow channel")</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_1" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" name="no dealflow" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dealflow == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_2" name="Write Slack Messages&#10;→ msg" lf:kind="write">
      <bpmn:documentation>write dealflow-[:Messages]-> { Message: "Who can take ${go.Text}? Reply in the thread." }</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2" />
    <bpmn:eventBasedGateway id="EventBasedGateway_1" lf:kind="decision">
      <bpmn:documentation>r = race(
    () => {
      reply = await msg-[:Replies]->
      return reply.Message
    },
    () => { await sleep(1d) },
  )
Ties: when arms settle in the same moment listen-fire lands every one; BPMN takes one.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="ServiceTask_2" targetRef="EventBasedGateway_1" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="Wait for Replies on msg&#10;→ reply" lf:kind="read">
      <bpmn:documentation>await msg-[:Replies]-></bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_1" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2" name="Wait 1 day" lf:kind="plain">
      <bpmn:documentation>await sleep(1d)</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_2" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" lf:kind="decision">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_8" name="reply.Message" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="IntermediateCatchEvent_2" targetRef="ExclusiveGateway_2" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" default="Flow_12" lf:kind="decision">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3" />
    <bpmn:serviceTask id="ServiceTask_3" name="Write Slack Messages" lf:kind="write">
      <bpmn:documentation>write dealflow-[:Messages]-> { Message: "Nobody picked up ${go.Text}." }</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_11" name="no r[0]" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">r[0] == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" lf:kind="decision">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_4" />
    <bpmn:endEvent id="EndEvent_2" name="Done" lf:kind="plain">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_2" />
  </bpmn:process>
  <bpmn:message id="Message_1" name="msg Replies" />
  <bpmn:error id="Error_1" name="no #dealflow channel" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
