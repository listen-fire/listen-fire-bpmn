<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:lf="https://listen-fire.dev/schema/bpmn" id="Definitions_1" targetNamespace="https://listen-fire.dev/schema/bpmn" exporter="@listen-fire/bpmn" exporterVersion="0.16.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="triage" processRef="Process_triage" lf:kind="pool" />
    <bpmn:participant id="Participant_2" name="Email" lf:kind="system">
      <bpmn:documentation>Connected system: `inbox`, a connection of email. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_3" name="Slack" lf:kind="system">
      <bpmn:documentation>Connected system: `chat`, a connection of slack. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_4" name="Gmail" lf:kind="system">
      <bpmn:documentation>Connected system: `mail`, a connection of gmail. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MessageFlow_1" name="reads Emails" sourceRef="Participant_2" targetRef="StartEvent_1" />
    <bpmn:messageFlow id="MessageFlow_2" name="reads Channels" sourceRef="Participant_3" targetRef="ServiceTask_2" />
    <bpmn:messageFlow id="MessageFlow_3" name="writes Messages" sourceRef="ServiceTask_3" targetRef="Participant_3" />
    <bpmn:messageFlow id="MessageFlow_4" name="writes Messages" sourceRef="ServiceTask_4" targetRef="Participant_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_triage" name="triage" isExecutable="false">
    <bpmn:documentation>Function `triage` in support_email_triage.mvt, drawn by @listen-fire/bpmn from the checked program.
Connected systems it touches: Slack, Gmail, Email.
Queries are carried as text, types are dropped, and expressions are folded into the steps that use them; the program is the authority.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="On Email Emails&#10;→ m" lf:kind="read">
      <bpmn:documentation>listen to inbox-[e:Emails WHERE e.Key == "support"]-> fire triage</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Extract Verdict (AI)&#10;→ verdict" implementation="urn:listen-fire:ai" lf:kind="ai">
      <bpmn:documentation>AI step. Output: one Verdict or nothing. Settings: { tier: "careful" }.
extractOne([m.Subject, m.Body], Verdict, { tier: "careful" })</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" default="Flow_7" lf:kind="decision">
      <bpmn:documentation>where category = coalesce(verdict?.category, "normal")</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1" />
    <bpmn:serviceTask id="ServiceTask_2" name="Read Slack Channels&#10;→ oncall" lf:kind="read">
      <bpmn:documentation>oncall = only(chat-[ch:Channels WHERE ch.Name == "general"]->)</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" name="category == &#34;urgent&#34;" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">category == "urgent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" default="Flow_6" lf:kind="decision">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2" />
    <bpmn:endEvent id="EndEvent_1" name="Fail: no #general channel" lf:kind="failure">
      <bpmn:documentation>fail("no #general channel")</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_1" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" name="no oncall" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">oncall == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_3" name="Write Slack Messages" lf:kind="write">
      <bpmn:documentation>write oncall-[:Messages]-> { Message: "Urgent support email from ${sender}: ${line}" }
where sender = Text.regexExtract(m.From, "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+)", 1)
where line = coalesce(verdict?.summary, "(no summary)")</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_3" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" lf:kind="decision">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_3" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_3" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" default="Flow_13" lf:kind="decision">
      <bpmn:documentation>where category = coalesce(verdict?.category, "normal")</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_5" default="Flow_12" lf:kind="decision">
      <bpmn:documentation>where sender = Text.regexExtract(m.From, "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+)", 1)</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_10" name="category == &#34;normal&#34;" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">category == "normal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_2" name="Fail: normal email with no sender address to reply to" lf:kind="failure">
      <bpmn:documentation>fail("normal email with no sender address to reply to")</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_2" errorRef="Error_2" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" name="no sender" sourceRef="ExclusiveGateway_5" targetRef="EndEvent_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sender == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_4" name="Write Gmail Messages" lf:kind="write">
      <bpmn:documentation>write mail-[:Messages]-> {
      To: [sender]
      Subject: "We have received your message"
      Body: "Thank you for contacting support. We will respond within one working day."
    }
where sender = Text.regexExtract(m.From, "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+)", 1)</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ExclusiveGateway_5" targetRef="ServiceTask_4" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_6" lf:kind="decision">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_6" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ServiceTask_4" targetRef="ExclusiveGateway_6" />
    <bpmn:endEvent id="EndEvent_3" name="Done" lf:kind="plain">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ExclusiveGateway_6" targetRef="EndEvent_3" />
  </bpmn:process>
  <bpmn:message id="Message_1" name="Email Emails" />
  <bpmn:error id="Error_1" name="no #general channel" />
  <bpmn:error id="Error_2" name="normal email with no sender address to reply to" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
