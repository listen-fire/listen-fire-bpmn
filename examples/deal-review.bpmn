<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="https://listen-fire.dev/schema/bpmn" exporter="listen-fire-bpmn" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Review deals" processRef="Process_Review_deals" />
    <bpmn:participant id="Participant_2" name="Notify owner" processRef="Process_Notify_owner" />
    <bpmn:participant id="Participant_3" name="Airtable">
      <bpmn:documentation>Connected system: `crm = connect airtable …`. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_4" name="Slack">
      <bpmn:documentation>Connected system: `chat = connect slack …`. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_5" name="Asks (people)">
      <bpmn:documentation>Connected system: `asks = connect ask …`. Drawn as a black box.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Participant_3" targetRef="ServiceTask_1" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="ServiceTask_4" targetRef="Participant_3" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Participant_4" targetRef="ServiceTask_5" />
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="SendTask_1" targetRef="Participant_4" />
    <bpmn:messageFlow id="MessageFlow_5" sourceRef="UserTask_1" targetRef="Participant_5" />
    <bpmn:messageFlow id="MessageFlow_6" sourceRef="Participant_5" targetRef="IntermediateCatchEvent_1" />
    <bpmn:messageFlow id="MessageFlow_7" sourceRef="ServiceTask_6" targetRef="Participant_3" />
    <bpmn:messageFlow id="MessageFlow_8" sourceRef="SendTask_2" targetRef="Participant_4" />
    <bpmn:messageFlow id="MessageFlow_9" sourceRef="ServiceTask_7" targetRef="Participant_3" />
    <bpmn:messageFlow id="MessageFlow_10" sourceRef="Participant_4" targetRef="ServiceTask_8" />
    <bpmn:messageFlow id="MessageFlow_11" sourceRef="SendTask_3" targetRef="Participant_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Review_deals" name="Review deals" isExecutable="false">
    <bpmn:documentation>Function `Review deals` in deal-review.mvt, drawn by listen-fire-bpmn from the parsed program.
Connected systems it touches: Airtable, Slack, Asks (people).
Queries are carried as text, types are dropped, and expressions are folded into the steps that use them; the program is the authority.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="Started manually">
      <bpmn:documentation>listen to go fire Review deals</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Read Airtable Deals">
      <bpmn:documentation>deals = crm-[d:Deals WHERE d.Stage == "Negotiation"]-&gt;</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:subProcess id="SubProcess_1" name="For each Airtable Deal (up to 4 at once, failures skipped)">
      <bpmn:documentation>map(deals, …): runs once per member.
Concurrency limit 4 (BPMN cannot express the limit; it is noted here).
onError: "warn" — a failing member is reported and the others carry on.
map(deals, { concurrency: 4, onError: "warn" }, (d) =&gt; {
    risk = extractOne([d.Notes], Risk, { tier: "quick" })
    headline = ai("a five word headline for: ${d.Notes}")
    write d { Risk: coalesce(risk.summary, ""), Headline: coalesce(headline, "") }
  })</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics id="MultiInstanceLoopCharacteristics_1" />
      <bpmn:startEvent id="StartEvent_2">
        <bpmn:outgoing>Flow_2</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask_2" name="Extract Risk (AI)" implementation="urn:listen-fire:ai">
        <bpmn:documentation>AI step. Output: one Risk or nothing. Settings: { tier: "quick" }.
risk = extractOne([d.Notes], Risk, { tier: "quick" })</bpmn:documentation>
        <bpmn:incoming>Flow_2</bpmn:incoming>
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_2" sourceRef="StartEvent_2" targetRef="ServiceTask_2" />
      <bpmn:serviceTask id="ServiceTask_3" name="Generate headline (AI)" implementation="urn:listen-fire:ai">
        <bpmn:documentation>AI step: ai("a five word headline for: ${d.Notes}")
headline = ai("a five word headline for: ${d.Notes}")</bpmn:documentation>
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_3" sourceRef="ServiceTask_2" targetRef="ServiceTask_3" />
      <bpmn:serviceTask id="ServiceTask_4" name="Update Airtable Deal">
        <bpmn:documentation>write d { Risk: coalesce(risk.summary, ""), Headline: coalesce(headline, "") }</bpmn:documentation>
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_4" sourceRef="ServiceTask_3" targetRef="ServiceTask_4" />
      <bpmn:endEvent id="EndEvent_1" name="Done">
        <bpmn:incoming>Flow_5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_5" sourceRef="ServiceTask_4" targetRef="EndEvent_1" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ServiceTask_1" targetRef="SubProcess_1" />
    <bpmn:parallelGateway id="ParallelGateway_1">
      <bpmn:documentation>r = all(
    () =&gt; { `Notify owner`(deal: only(deals)) },
    () =&gt; {
      ops = only(chat-[ch:Channels WHERE ch.Name == "ops"]-&gt;)
      if (ops != null) { write ops-[:Messages]-&gt; { Message: "Deal review started" } }
    },
  )</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="SubProcess_1" targetRef="ParallelGateway_1" />
    <bpmn:callActivity id="CallActivity_1" name="Notify owner" calledElement="Process_Notify_owner">
      <bpmn:documentation>`Notify owner`(deal: only(deals))</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ParallelGateway_1" targetRef="CallActivity_1" />
    <bpmn:serviceTask id="ServiceTask_5" name="Read Slack Channels">
      <bpmn:documentation>ops = only(chat-[ch:Channels WHERE ch.Name == "ops"]-&gt;)</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="ParallelGateway_1" targetRef="ServiceTask_5" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" default="Flow_12">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ServiceTask_5" targetRef="ExclusiveGateway_1" />
    <bpmn:sendTask id="SendTask_1" name="Post to Slack channel">
      <bpmn:documentation>write ops-[:Messages]-&gt; { Message: "Deal review started" }</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_11" name="ops != null" sourceRef="ExclusiveGateway_1" targetRef="SendTask_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ops != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="SendTask_1" targetRef="ExclusiveGateway_2" />
    <bpmn:parallelGateway id="ParallelGateway_2">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="CallActivity_1" targetRef="ParallelGateway_2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_2" />
    <bpmn:userTask id="UserTask_1" name="Ask: Approve the negotiation batch?">
      <bpmn:documentation>q = write asks-[:Check]-&gt; { Prompt: "Approve the negotiation batch?" }</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="ParallelGateway_2" targetRef="UserTask_1" />
    <bpmn:subProcess id="SubProcess_2" name="Race: first to finish wins">
      <bpmn:documentation>verdict = race(
    () =&gt; {
      a = await first(q-[:Response]-&gt;)
      if (a.Answer) {
        write crm-[:Approvals]-&gt; { Batch: "negotiation", Approved: true }
        return "approved"
      } else {
        return "declined"
      }
    },
    () =&gt; {
      await sleep(2d)
      write chat-[:Messages]-&gt; { Message: "Nobody answered the batch review" }
      return "expired"
    },
  )
Every arm starts at once; the first to reach a terminate end event ends the race and stops the rest.
Ties: when arms settle in the same moment listen-fire lands every one; BPMN takes one.</bpmn:documentation>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_3">
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway_3">
        <bpmn:incoming>Flow_17</bpmn:incoming>
        <bpmn:outgoing>Flow_18</bpmn:outgoing>
        <bpmn:outgoing>Flow_23</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sequenceFlow id="Flow_17" sourceRef="StartEvent_3" targetRef="ParallelGateway_3" />
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="Wait for answer: Approve the negotiation batch?">
        <bpmn:documentation>a = await first(q-[:Response]-&gt;)</bpmn:documentation>
        <bpmn:incoming>Flow_18</bpmn:incoming>
        <bpmn:outgoing>Flow_19</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_1" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_18" sourceRef="ParallelGateway_3" targetRef="IntermediateCatchEvent_1" />
      <bpmn:exclusiveGateway id="ExclusiveGateway_3" default="Flow_22">
        <bpmn:incoming>Flow_19</bpmn:incoming>
        <bpmn:outgoing>Flow_20</bpmn:outgoing>
        <bpmn:outgoing>Flow_22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_19" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_3" />
      <bpmn:serviceTask id="ServiceTask_6" name="Write Airtable Approvals">
        <bpmn:documentation>write crm-[:Approvals]-&gt; { Batch: "negotiation", Approved: true }</bpmn:documentation>
        <bpmn:incoming>Flow_20</bpmn:incoming>
        <bpmn:outgoing>Flow_21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_20" name="a.Answer" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_6">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">a.Answer</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="EndEvent_2" name="Return &#34;approved&#34;">
        <bpmn:documentation>return "approved"</bpmn:documentation>
        <bpmn:incoming>Flow_21</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TerminateEventDefinition_1" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_21" sourceRef="ServiceTask_6" targetRef="EndEvent_2" />
      <bpmn:endEvent id="EndEvent_3" name="Return &#34;declined&#34;">
        <bpmn:documentation>return "declined"</bpmn:documentation>
        <bpmn:incoming>Flow_22</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TerminateEventDefinition_2" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_22" name="else" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_3" />
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2" name="Wait 2 days">
        <bpmn:documentation>await sleep(2d)</bpmn:documentation>
        <bpmn:incoming>Flow_23</bpmn:incoming>
        <bpmn:outgoing>Flow_24</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_1">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_23" sourceRef="ParallelGateway_3" targetRef="IntermediateCatchEvent_2" />
      <bpmn:sendTask id="SendTask_2" name="Send Slack message">
        <bpmn:documentation>write chat-[:Messages]-&gt; { Message: "Nobody answered the batch review" }</bpmn:documentation>
        <bpmn:incoming>Flow_24</bpmn:incoming>
        <bpmn:outgoing>Flow_25</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_24" sourceRef="IntermediateCatchEvent_2" targetRef="SendTask_2" />
      <bpmn:endEvent id="EndEvent_4" name="Return &#34;expired&#34;">
        <bpmn:documentation>return "expired"</bpmn:documentation>
        <bpmn:incoming>Flow_25</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TerminateEventDefinition_3" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_25" sourceRef="SendTask_2" targetRef="EndEvent_4" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="UserTask_1" targetRef="SubProcess_2" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_3" name="Wait until lead != null">
      <bpmn:documentation>await until(() =&gt; {
    lead = only(crm-[d:Deals WHERE d.Stage == "Won"]-&gt;)
    return lead != null
  }, { every: 1h })
Re-checked every 1 hour.
Each check reads Airtable Deals.</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_1">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">lead != null</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="SubProcess_2" targetRef="IntermediateCatchEvent_3" />
    <bpmn:serviceTask id="ServiceTask_7" name="Write Airtable Log">
      <bpmn:documentation>write crm-[:Log]-&gt; { Outcome: coalesce(verdict[0], verdict[1], "unknown") }</bpmn:documentation>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="IntermediateCatchEvent_3" targetRef="ServiceTask_7" />
    <bpmn:endEvent id="EndEvent_5" name="Done">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="ServiceTask_7" targetRef="EndEvent_5" />
    <bpmn:subProcess id="SubProcess_3" name="When more is called" triggeredByEvent="true">
      <bpmn:documentation>more = callback({ }, { once: false })
Repeatable: fires every time it is called.
It shares the run's data, as a callback shares the run's scope.</bpmn:documentation>
      <bpmn:startEvent id="StartEvent_4" name="more called" isInterrupting="false">
        <bpmn:outgoing>Flow_30</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_2" messageRef="Message_2" />
      </bpmn:startEvent>
      <bpmn:endEvent id="EndEvent_6" name="Done">
        <bpmn:incoming>Flow_30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_30" sourceRef="StartEvent_4" targetRef="EndEvent_6" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:process id="Process_Notify_owner" name="Notify owner" isExecutable="false">
    <bpmn:documentation>Function `Notify owner` in deal-review.mvt, drawn by listen-fire-bpmn from the parsed program.
Connected systems it touches: Slack.
Queries are carried as text, types are dropped, and expressions are folded into the steps that use them; the program is the authority.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_5" name="Called">
      <bpmn:documentation>Started by a call from another function.</bpmn:documentation>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_8" name="Read Slack Channels">
      <bpmn:documentation>owners = only(chat-[ch:Channels WHERE ch.Name == "deal-owners"]-&gt;)</bpmn:documentation>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="StartEvent_5" targetRef="ServiceTask_8" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" default="Flow_34">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="ServiceTask_8" targetRef="ExclusiveGateway_4" />
    <bpmn:endEvent id="EndEvent_7" name="Fail: no #deal-owners channel">
      <bpmn:documentation>fail("no #deal-owners channel") </bpmn:documentation>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_1" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_33" name="owners == null" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">owners == null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="SendTask_3" name="Post to Slack channel">
      <bpmn:documentation>write owners-[:Messages]-&gt; { Message: "Deal ${deal.Name} needs a look" }</bpmn:documentation>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="ExclusiveGateway_4" targetRef="SendTask_3" />
    <bpmn:endEvent id="EndEvent_8" name="Done">
      <bpmn:incoming>Flow_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="SendTask_3" targetRef="EndEvent_8" />
  </bpmn:process>
  <bpmn:message id="Message_1" name="q Response" />
  <bpmn:message id="Message_2" name="more Called" />
  <bpmn:error id="Error_1" name="no #deal-owners channel" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2818" height="744" />
      </bpmndi:BPMNShape>
